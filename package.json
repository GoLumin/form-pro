{
  "name": "@golumin/astro-form-console",
  "version": "0.1.0",
  "description": "An Astro integration that gives a marketing site one declared source of truth for its lead forms — email envelopes, CRM webhook keys and pricing — plus an authenticated console at /form-preview to test, edit and monitor them.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./types": "./src/types.ts",
    "./email": "./src/email/index.ts",
    "./canary": "./src/canary.ts",
    "./auth": "./src/auth.ts",
    "./env": "./src/env.ts",
    "./editor": "./src/editor/index.ts",
    "./routes/*": "./src/routes/*",
    "./components/*": "./src/components/*",
    "./package.json": "./package.json",
    "./routing": "./src/routing.ts",
    "./catalog": "./src/catalog.ts",
    "./dateFormats": "./src/dateFormats.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "astro": ">=6"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  }
}
