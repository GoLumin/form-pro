---
// The sign-in page: an address, then the code that arrives in its inbox.
//
// Standalone and self-contained like the console it guards, and styled from the
// same bundle — a sign-in page that looks like a different product is the
// easiest kind of page to phish.
import options from 'virtual:form-pro/options'
import { PROFILES } from 'virtual:form-pro/config'
import { auth, sessionUser } from '../auth/server.ts'

export const prerender = false

// Nothing to sign in to without a database; that site is still on its shared
// password, and this page would be a dead end.
if (!auth()) return Astro.redirect(options.route)
if (await sessionUser(Astro.request)) return Astro.redirect(options.route)

const brand = options.title || Object.values(PROFILES)[0]?.name || 'Form console'
const assets = `${options.route}/assets`
const v = encodeURIComponent(options.version)
const bootstrap = { route: options.route, brand, api: `${options.route}/auth` }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{brand} — sign in</title>
    <link rel="stylesheet" href={`${assets}/console.css?v=${v}`} />
  </head>
  <body>
    <div id="form-console-signin"></div>
    <script is:inline define:vars={{ bootstrap }}>
      window.__formConsoleSignIn = bootstrap
    </script>
    <script is:inline type="module" src={`${assets}/signin.js?v=${v}`}></script>
  </body>
</html>
